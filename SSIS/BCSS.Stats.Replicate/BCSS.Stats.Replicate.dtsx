    <DTS:Executable
      DTS:refId="Package\Disable FKs"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{321F3014-908E-48DC-B7B1-908C283E466E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Disable FKs"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{762C991A-B507-40E2-AAAE-F6262F4D019C}"
          SQLTask:SqlStatementSource="DECLARE&#xA;    v_schema VARCHAR2(128) := UPPER(?);&#xA;BEGIN&#xA;    FOR c IN (&#xA;        SELECT owner, table_name, constraint_name&#xA;        FROM all_constraints&#xA;        WHERE owner = v_schema&#xA;          AND constraint_type = 'R'&#xA;          AND status = 'ENABLED'&#xA;AND table_name IN (&#xA;              'STAT_GROUPS',&#xA;              'STAT_METRICS',&#xA;              'STAT_CATEGORIES',&#xA;              'SUB_CATEGORIES',&#xA;              'SUB_CATEGORY_METRICS',&#xA;              'STAT_RECORDS',&#xA;              'STAT_SIGNOFFS'&#xA;          )&#xA;    )&#xA;    LOOP&#xA;        EXECUTE IMMEDIATE&#xA;            'ALTER TABLE &quot;' || c.owner ||&#xA;            '&quot;.&quot;' || c.table_name ||&#xA;            '&quot; DISABLE CONSTRAINT &quot;' || c.constraint_name || '&quot;';&#xA;    END LOOP;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="TargetSchema"
            SQLTask:DtsVariableName="User::TargetSchema"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Enable FKs"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{63B12778-FEAF-4700-96D8-74ECC37C0C82}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Enable FKs"
