                      name="ODBC Source Output"
                      truncationRowDisposition="FailComponent">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Sequence Container\Copy STAT_CATEGORIES\ODBC Source.Outputs[ODBC Source Output].Columns[Id]"
                          dataType="i4"
                          externalMetadataColumnId="Package\Sequence Container\Copy STAT_CATEGORIES\ODBC Source.Outputs[ODBC Source Output].ExternalColumns[Id]"
                          lineageId="Package\Sequence Container\Copy STAT_CATEGORIES\ODBC Source.Outputs[ODBC Source Output].Columns[Id]"
                          name="Id" />
                        <outputColumn
                          refId="Package\Sequence Container\Copy STAT_CATEGORIES\ODBC Source.Outputs[ODBC Source Output].Columns[GroupId]"
                          dataType="i4"
                          externalMetadataColumnId="Package\Sequence Container\Copy STAT_CATEGORIES\ODBC Source.Outputs[ODBC Source Output].ExternalColumns[GroupId]"
                          lineageId="Package\Sequence Container\Copy STAT_CATEGORIES\ODBC Source.Outputs[ODBC Source Output].Columns[GroupId]"
                          name="GroupId" />
                        <outputColumn
