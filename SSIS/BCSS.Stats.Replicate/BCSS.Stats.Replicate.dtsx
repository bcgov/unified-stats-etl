    "Id",
    "SubCategoryId",
    "MetricId",
    "DisplayOrder",
    replace("CreatedById"::text, '-', '')::varchar(32) AS "CreatedByIdHex",
    "CreatedOn" AT TIME ZONE 'UTC' AS "CreatedOn",
    replace("UpdatedById"::text, '-', '')::varchar(32) AS "UpdatedByIdHex",
    "UpdatedOn" AT TIME ZONE 'UTC' AS "UpdatedOn",
    (CASE WHEN "IsRequired" THEN 'Y' ELSE 'N' END)::varchar(1) AS "IsRequired",
    (CASE WHEN "IsArchived" THEN 'Y' ELSE 'N' END)::varchar(1) AS "IsArchived"
FROM public."SubCategoryMetrics";</property>
