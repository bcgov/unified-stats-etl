          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
              SQLTask:SqlStatementSource="UPDATE etl.&quot;BiOracleEtlRuns&quot;&#xA;SET&#xA;    &quot;StagedCellCount&quot; = ?::integer,&#xA;    &quot;LoadedCellCount&quot; = ?::integer,&#xA;    &quot;Status&quot; = 'Succeeded',&#xA;    &quot;CompletedAt&quot; = CURRENT_TIMESTAMP&#xA;WHERE &quot;LoadId&quot; = ?::uuid;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="CellsApplied"
                SQLTask:DtsVariableName="User::StagedCellCount"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="4"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="LoadedCount"
                SQLTask:DtsVariableName="User::OracleLoadedRowCount"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="4"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="LoadId"
                SQLTask:DtsVariableName="User::LoadId"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="-9"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
