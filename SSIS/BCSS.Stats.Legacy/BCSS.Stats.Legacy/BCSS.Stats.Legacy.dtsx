    <DTS:Executable
      DTS:refId="Package\Get Staged Cell Count"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D0D3AD5C-DBC0-4A7E-A666-D7B66D08C912}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Get Staged Cell Count"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
          SQLTask:SqlStatementSource="SELECT COUNT(*)::integer AS staged_cell_count&#xA;FROM etl.&quot;BiOracleStatStages&quot;&#xA;WHERE &quot;LoadId&quot; = ?::uuid;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::StagedCellCount" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="LoadId"
            SQLTask:DtsVariableName="User::LoadId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="-9"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\GetMappingDataSet For Report Date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A76B3C6D-10CF-43A9-8C34-35C1D209647A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="GetMappingDataSet For Report Date"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
          SQLTask:SqlStatementSource="WITH params AS&#xA;(&#xA;    SELECT ?::date AS report_month&#xA;)&#xA;SELECT&#xA;    COUNT(ms.&quot;Id&quot;) AS match_count,&#xA;    CASE&#xA;        WHEN COUNT(ms.&quot;Id&quot;) = 1 THEN MIN(ms.&quot;Id&quot;)&#xA;        ELSE (&#xA;            'Expected exactly one mapping set effective on '&#xA;            || p.report_month::text&#xA;            || '; found '&#xA;            || COUNT(ms.&quot;Id&quot;)::text&#xA;        )::integer&#xA;    END AS mapping_set_id&#xA;FROM params p&#xA;LEFT JOIN etl.&quot;BiOracleStatMappingSets&quot; ms&#xA;    ON ms.&quot;EffectiveDate&quot; &lt;= p.report_month&#xA;   AND (&#xA;        ms.&quot;ExpiryDate&quot; IS NULL&#xA;        OR p.report_month &lt; ms.&quot;ExpiryDate&quot;&#xA;   )&#xA;GROUP BY p.report_month;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::ResultSetCount" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="2"
            SQLTask:DtsVariableName="User::ResultSetId" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="ReportDate"
            SQLTask:DtsVariableName="User::ReportDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="-9"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Insert STATS Into Staging Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{33DE00E3-AF03-47F0-B4ED-09096966C256}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insert STATS Into Staging Table"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
          SQLTask:SqlStatementSource="WITH params AS&#xA;(&#xA;    SELECT&#xA;        CAST(? AS uuid)    AS load_id,&#xA;        CAST(? AS date)    AS reporting_month,&#xA;        CAST(? AS integer) AS mapping_set_id&#xA;),&#xA;&#xA;source_rows AS&#xA;(&#xA;    SELECT&#xA;        sr.&quot;Id&quot; AS stat_record_id,&#xA;        sr.&quot;SubCategoryMetricId&quot;,&#xA;        sr.&quot;Value&quot;,&#xA;&#xA;        COALESCE(&#xA;            sr.&quot;PerformedAtLocationId&quot;,&#xA;            sr.&quot;LocationId&quot;&#xA;        ) AS effective_location_id,&#xA;&#xA;        sg.&quot;Name&quot; AS stat_group_name,&#xA;        sg.&quot;IsLocationLevel&quot;,&#xA;&#xA;        sm.&quot;UnitOfMeasure&quot;,&#xA;        sm.&quot;IsOvertime&quot;,&#xA;&#xA;        CASE sg.&quot;Name&quot;&#xA;            WHEN 'Supervision' THEN TRUE&#xA;            WHEN 'Non-Supervision' THEN FALSE&#xA;            WHEN 'Location Level' THEN FALSE&#xA;            ELSE NULL&#xA;        END AS is_supervisor&#xA;&#xA;    FROM &quot;StatRecords&quot; sr&#xA;&#xA;    INNER JOIN &quot;SubCategoryMetrics&quot; scm&#xA;        ON scm.&quot;Id&quot; = sr.&quot;SubCategoryMetricId&quot;&#xA;&#xA;    INNER JOIN &quot;SubCategories&quot; sc&#xA;        ON sc.&quot;Id&quot; = scm.&quot;SubCategoryId&quot;&#xA;&#xA;    INNER JOIN &quot;StatCategories&quot; cat&#xA;        ON cat.&quot;Id&quot; = sc.&quot;CategoryId&quot;&#xA;&#xA;    INNER JOIN &quot;StatGroups&quot; sg&#xA;        ON sg.&quot;Id&quot; = cat.&quot;GroupId&quot;&#xA;&#xA;    INNER JOIN &quot;StatMetrics&quot; sm&#xA;        ON sm.&quot;Id&quot; = scm.&quot;MetricId&quot;&#xA;&#xA;    CROSS JOIN params p&#xA;&#xA;    WHERE sr.&quot;Status&quot; IN ('SignedOff')&#xA;&#xA;      -- Do not export records belonging to archived taxonomy.&#xA;      AND COALESCE(scm.&quot;IsArchived&quot;, FALSE) = FALSE&#xA;      AND COALESCE(cat.&quot;IsArchived&quot;, FALSE) = FALSE&#xA;      AND COALESCE(sc.&quot;IsArchived&quot;, FALSE) = FALSE&#xA;&#xA;      -- Include a StatRecord if any part of its DateFrom-DateTo&#xA;      -- range overlaps the reporting month.&#xA;      AND sr.&quot;DateFrom&quot; &lt; (p.reporting_month + INTERVAL '1 month')&#xA;      AND sr.&quot;DateTo&quot; &gt;= p.reporting_month&#xA;),&#xA;&#xA;mapped_rows AS&#xA;(&#xA;    SELECT&#xA;        s.stat_record_id,&#xA;        s.&quot;SubCategoryMetricId&quot;,&#xA;        s.&quot;Value&quot;,&#xA;&#xA;        s.is_supervisor,&#xA;        s.&quot;IsLocationLevel&quot;,&#xA;&#xA;        s.&quot;UnitOfMeasure&quot;,&#xA;        s.&quot;IsOvertime&quot;,&#xA;&#xA;        lm.&quot;CrtLocId&quot;,&#xA;&#xA;        m.&quot;TargetTable&quot;,&#xA;        m.&quot;TargetColumn&quot;&#xA;&#xA;    FROM source_rows s&#xA;&#xA;    CROSS JOIN params p&#xA;&#xA;    INNER JOIN &quot;Locations&quot; l&#xA;        ON l.&quot;Id&quot; = s.effective_location_id&#xA;&#xA;    INNER JOIN etl.&quot;BiOracleLocationMapping&quot; lm&#xA;        ON lm.&quot;JustinLocationCode&quot; = l.&quot;JustinLocationCode&quot;&#xA;&#xA;       -- Use the location crosswalk that is active for the reporting month.&#xA;       AND lm.&quot;EffectiveDate&quot; &lt;= p.reporting_month&#xA;       AND (&#xA;            lm.&quot;ExpiryDate&quot; IS NULL&#xA;            OR lm.&quot;ExpiryDate&quot; &gt;= p.reporting_month&#xA;       )&#xA;&#xA;    INNER JOIN etl.&quot;BiOracleStatMappings&quot; m&#xA;        ON m.&quot;SubCategoryMetricId&quot; = s.&quot;SubCategoryMetricId&quot;&#xA;&#xA;    WHERE m.&quot;MappingSetId&quot; = p.mapping_set_id&#xA;),&#xA;&#xA;/*&#xA; * Calculate the monthly subtotal for each logical component.&#xA; *&#xA; * For hour-based totals in SHERIFF_SRVCES, regular and overtime are kept&#xA; * separate at this stage so that each can independently apply the same&#xA; * positive-only rule as its SHERIFF_SRVCES_HOURS counterpart.&#xA; *&#xA; * For all other statistics, component_type is NULL and the existing&#xA; * aggregation behaviour is unchanged.&#xA; */&#xA;component_aggregated AS&#xA;(&#xA;    SELECT&#xA;        p.load_id AS &quot;LoadId&quot;,&#xA;        p.reporting_month AS &quot;ReportingMonth&quot;,&#xA;&#xA;        m.&quot;CrtLocId&quot;,&#xA;        m.is_supervisor AS &quot;IsSupervisor&quot;,&#xA;&#xA;        m.&quot;TargetTable&quot;,&#xA;        m.&quot;TargetColumn&quot;,&#xA;&#xA;        CASE&#xA;            WHEN m.&quot;TargetTable&quot; = 'SHERIFF_SRVCES'&#xA;             AND LOWER(COALESCE(m.&quot;UnitOfMeasure&quot;, '')) = 'hours'&#xA;            THEN m.&quot;IsOvertime&quot;&#xA;            ELSE NULL&#xA;        END AS hour_component_is_overtime,&#xA;&#xA;        BOOL_OR(m.&quot;IsLocationLevel&quot;) AS &quot;IsLocationLevel&quot;,&#xA;&#xA;        SUM(m.&quot;Value&quot;) AS component_value,&#xA;        COUNT(*) AS component_source_row_count&#xA;&#xA;    FROM mapped_rows m&#xA;    CROSS JOIN params p&#xA;&#xA;    GROUP BY&#xA;        p.load_id,&#xA;        p.reporting_month,&#xA;        m.&quot;CrtLocId&quot;,&#xA;        m.is_supervisor,&#xA;        m.&quot;TargetTable&quot;,&#xA;        m.&quot;TargetColumn&quot;,&#xA;&#xA;        CASE&#xA;            WHEN m.&quot;TargetTable&quot; = 'SHERIFF_SRVCES'&#xA;             AND LOWER(COALESCE(m.&quot;UnitOfMeasure&quot;, '')) = 'hours'&#xA;            THEN m.&quot;IsOvertime&quot;&#xA;            ELSE NULL&#xA;        END&#xA;),&#xA;&#xA;/*&#xA; * Recombine the components into the actual Oracle destination cell.&#xA; *&#xA; * Hour totals:&#xA; *     positive regular subtotal&#xA; *   + positive overtime subtotal&#xA; *&#xA; * Non-hour statistics retain their normal summed value.&#xA; */&#xA;aggregated AS&#xA;(&#xA;    SELECT&#xA;        &quot;LoadId&quot;,&#xA;        &quot;ReportingMonth&quot;,&#xA;        &quot;CrtLocId&quot;,&#xA;        &quot;IsSupervisor&quot;,&#xA;&#xA;        BOOL_OR(&quot;IsLocationLevel&quot;) AS &quot;IsLocationLevel&quot;,&#xA;&#xA;        &quot;TargetTable&quot;,&#xA;        &quot;TargetColumn&quot;,&#xA;&#xA;        SUM(&#xA;            CASE&#xA;                WHEN &quot;TargetTable&quot; = 'SHERIFF_SRVCES'&#xA;                 AND hour_component_is_overtime IS NOT NULL&#xA;                THEN GREATEST(component_value, 0)&#xA;                ELSE component_value&#xA;            END&#xA;        ) AS &quot;StatValue&quot;,&#xA;&#xA;        SUM(component_source_row_count) AS &quot;SourceRowCount&quot;&#xA;&#xA;    FROM component_aggregated&#xA;&#xA;    GROUP BY&#xA;        &quot;LoadId&quot;,&#xA;        &quot;ReportingMonth&quot;,&#xA;        &quot;CrtLocId&quot;,&#xA;        &quot;IsSupervisor&quot;,&#xA;        &quot;TargetTable&quot;,&#xA;        &quot;TargetColumn&quot;&#xA;),&#xA;&#xA;/*&#xA; * Regular/overtime detail columns are still omitted when their final&#xA; * monthly sum is zero or negative.&#xA; */&#xA;filtered AS&#xA;(&#xA;    SELECT *&#xA;    FROM aggregated&#xA;    WHERE&#xA;        &quot;TargetTable&quot; &lt;&gt; 'SHERIFF_SRVCES_HOURS'&#xA;        OR &quot;StatValue&quot; &gt; 0&#xA;)&#xA;&#xA;INSERT INTO etl.&quot;BiOracleStatStages&quot;&#xA;(&#xA;    &quot;LoadId&quot;,&#xA;    &quot;ReportingMonth&quot;,&#xA;    &quot;CrtLocId&quot;,&#xA;    &quot;IsLocationLevel&quot;,&#xA;    &quot;IsSupervisor&quot;,&#xA;    &quot;TargetTable&quot;,&#xA;    &quot;TargetColumn&quot;,&#xA;    &quot;StatValue&quot;,&#xA;    &quot;SourceRowCount&quot;&#xA;)&#xA;SELECT&#xA;    &quot;LoadId&quot;,&#xA;    &quot;ReportingMonth&quot;,&#xA;    &quot;CrtLocId&quot;,&#xA;    &quot;IsLocationLevel&quot;,&#xA;    &quot;IsSupervisor&quot;,&#xA;    &quot;TargetTable&quot;,&#xA;    &quot;TargetColumn&quot;,&#xA;    &quot;StatValue&quot;,&#xA;    &quot;SourceRowCount&quot;&#xA;FROM filtered;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::LoadId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="-9"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::ReportDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="-9"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::ResultSetId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Failure Of ETL Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F3883953-CD25-436D-AC0F-D4DB15A7CA2C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Failure Of ETL Run"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
          SQLTask:SqlStatementSource="&#xA;-- Complete SQL for BCSS.Stats.Legacy / Log Failure Of ETL Run.&#xA;-- 24 positional parameters: 22 validation counters,&#xA;-- UnsafeOracleTargetCount, and LoadId.&#xA;&#xA;WITH validation AS&#xA;(&#xA;    SELECT&#xA;        CAST(? AS integer) AS eligible_source_record_count,&#xA;        CAST(? AS integer) AS invalid_date_range_count,&#xA;        CAST(? AS integer) AS null_value_count,&#xA;        CAST(? AS integer) AS nan_value_count,&#xA;        CAST(? AS integer) AS missing_location_count,&#xA;        CAST(? AS integer) AS missing_justin_location_code_count,&#xA;        CAST(? AS integer) AS missing_location_mapping_count,&#xA;        CAST(? AS integer) AS duplicate_location_mapping_count,&#xA;        CAST(? AS integer) AS missing_subcategory_metric_count,&#xA;        CAST(? AS integer) AS missing_subcategory_count,&#xA;        CAST(? AS integer) AS missing_category_count,&#xA;        CAST(? AS integer) AS missing_group_count,&#xA;        CAST(? AS integer) AS unknown_group_count,&#xA;        CAST(? AS integer) AS invalid_group_location_level_flag_count,&#xA;        CAST(? AS integer) AS unmapped_source_record_count,&#xA;        CAST(? AS integer) AS duplicate_stat_mapping_count,&#xA;        CAST(? AS integer) AS invalid_target_table_count,&#xA;        CAST(? AS integer) AS blank_target_column_count,&#xA;        CAST(? AS integer) AS location_level_collision_count,&#xA;        CAST(? AS integer) AS cross_month_record_count,&#xA;        CAST(? AS integer) AS archived_taxonomy_record_count,&#xA;        CAST(? AS integer) AS fatal_validation_count,&#xA;        CAST(? AS integer) AS unsafe_oracle_target_count&#xA;)&#xA;UPDATE etl.&quot;BiOracleEtlRuns&quot; r&#xA;SET&#xA;    &quot;Status&quot; = 'Failed',&#xA;    &quot;CompletedAt&quot; = CURRENT_TIMESTAMP,&#xA;    &quot;LoadedCellCount&quot; = 0,&#xA;    &quot;ErrorMessage&quot; =&#xA;        CONCAT_WS(&#xA;            E'\n',&#xA;            NULLIF(r.&quot;ErrorMessage&quot;, ''),&#xA;&#xA;            -- Failure unrelated to validation counts.&#xA;            CASE&#xA;                WHEN COALESCE(v.fatal_validation_count, 0) = 0&#xA;                 AND COALESCE(v.unsafe_oracle_target_count, 0) = 0&#xA;                THEN&#xA;                    'ETL processing failed outside source/target validation; '&#xA;                    || 'inspect the SSIS execution log for the task and provider error.'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.fatal_validation_count &gt; 0&#xA;                THEN 'Validation failed with '&#xA;                     || v.fatal_validation_count&#xA;                     || ' fatal validation issue(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.unsafe_oracle_target_count &gt; 0&#xA;                THEN 'Unsafe Oracle target mapping: '&#xA;                     || v.unsafe_oracle_target_count&#xA;                     || ' staged row(s) contain an invalid or prohibited Oracle target.'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.invalid_date_range_count &gt; 0&#xA;                THEN 'Invalid date range: '&#xA;                     || v.invalid_date_range_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.null_value_count &gt; 0&#xA;                THEN 'NULL statistic value: '&#xA;                     || v.null_value_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.nan_value_count &gt; 0&#xA;                THEN 'NaN statistic value: '&#xA;                     || v.nan_value_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.missing_location_count &gt; 0&#xA;                THEN 'Missing reporting location: '&#xA;                     || v.missing_location_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.missing_justin_location_code_count &gt; 0&#xA;                THEN 'Missing JUSTIN location code: '&#xA;                     || v.missing_justin_location_code_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.missing_location_mapping_count &gt; 0&#xA;                THEN 'Missing Oracle location mapping: '&#xA;                     || v.missing_location_mapping_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.duplicate_location_mapping_count &gt; 0&#xA;                THEN 'Duplicate Oracle location mapping: '&#xA;                     || v.duplicate_location_mapping_count&#xA;                     || ' location code(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.missing_subcategory_metric_count &gt; 0&#xA;                THEN 'Missing SubCategoryMetric: '&#xA;                     || v.missing_subcategory_metric_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.missing_subcategory_count &gt; 0&#xA;                THEN 'Missing SubCategory: '&#xA;                     || v.missing_subcategory_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.missing_category_count &gt; 0&#xA;                THEN 'Missing StatCategory: '&#xA;                     || v.missing_category_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.missing_group_count &gt; 0&#xA;                THEN 'Missing StatGroup: '&#xA;                     || v.missing_group_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.unknown_group_count &gt; 0&#xA;                THEN 'Unknown StatGroup: '&#xA;                     || v.unknown_group_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.invalid_group_location_level_flag_count &gt; 0&#xA;                THEN 'Invalid StatGroup location-level flag: '&#xA;                     || v.invalid_group_location_level_flag_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.unmapped_source_record_count &gt; 0&#xA;                THEN 'Missing BiOracle statistic mapping: '&#xA;                     || v.unmapped_source_record_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.duplicate_stat_mapping_count &gt; 0&#xA;                THEN 'Duplicate BiOracle statistic mapping: '&#xA;                     || v.duplicate_stat_mapping_count&#xA;                     || ' mapping(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.invalid_target_table_count &gt; 0&#xA;                THEN 'Invalid Oracle target table: '&#xA;                     || v.invalid_target_table_count&#xA;                     || ' mapping(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.blank_target_column_count &gt; 0&#xA;                THEN 'Blank Oracle target column: '&#xA;                     || v.blank_target_column_count&#xA;                     || ' mapping(s).'&#xA;            END,&#xA;&#xA;            -- Informational: not a fatal validation condition.&#xA;            CASE&#xA;                WHEN v.location_level_collision_count &gt; 0&#xA;                THEN 'Location Level / Non-Supervision shared cell '&#xA;                     || '(informational): '&#xA;                     || v.location_level_collision_count&#xA;                     || ' destination cell(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.cross_month_record_count &gt; 0&#xA;                THEN 'Cross-month source record: '&#xA;                     || v.cross_month_record_count&#xA;                     || ' source record(s).'&#xA;            END,&#xA;&#xA;            CASE&#xA;                WHEN v.archived_taxonomy_record_count &gt; 0&#xA;                THEN 'Archived taxonomy referenced: '&#xA;                     || v.archived_taxonomy_record_count&#xA;                     || ' source record(s).'&#xA;            END&#xA;        )&#xA;FROM validation v&#xA;WHERE r.&quot;LoadId&quot; = CAST(? AS uuid);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="EligibleSourceRecordCount"
            SQLTask:DtsVariableName="User::EligibleSourceRecordCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="InvalidDateRangeCount"
            SQLTask:DtsVariableName="User::InvalidDateRangeCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NullValueCount"
            SQLTask:DtsVariableName="User::NullValueCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NaNValueCount"
            SQLTask:DtsVariableName="User::NaNValueCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="MissingLocationCount"
            SQLTask:DtsVariableName="User::MissingLocationCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="MissingJustinLocationCodeCount"
            SQLTask:DtsVariableName="User::MissingJustinLocationCodeCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="MissingLocationMappingCount"
            SQLTask:DtsVariableName="User::MissingLocationMappingCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="DuplicateLocationMappingCount"
            SQLTask:DtsVariableName="User::DuplicateLocationMappingCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="MissingSubCategoryMetricCount"
            SQLTask:DtsVariableName="User::MissingSubCategoryMetricCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="MissingSubCategoryCount"
            SQLTask:DtsVariableName="User::MissingSubCategoryCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="MissingCategoryCount"
            SQLTask:DtsVariableName="User::MissingCategoryCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="MissingGroupCount"
            SQLTask:DtsVariableName="User::MissingGroupCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="UnknownGroupCount"
            SQLTask:DtsVariableName="User::UnknownGroupCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="InvalidGroupLocationLevelFlagCount"
            SQLTask:DtsVariableName="User::InvalidGroupLocationLevelFlagCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="UnmappedSourceRecordCount"
            SQLTask:DtsVariableName="User::UnmappedSourceRecordCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="DuplicateStatMappingCount"
            SQLTask:DtsVariableName="User::DuplicateStatMappingCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="InvalidTargetTableCount"
            SQLTask:DtsVariableName="User::InvalidTargetTableCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="4"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="BlankTargetColumnCount"
            SQLTask:DtsVariableName="User::BlankTargetColumnCount"
