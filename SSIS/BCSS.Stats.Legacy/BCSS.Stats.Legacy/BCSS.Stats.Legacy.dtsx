      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT DISTINCT \&quot;CrtLocId\&quot; &quot; +&#xA;&quot;FROM etl.\&quot;BiOracleStatStages\&quot; &quot; +&#xA;&quot;WHERE \&quot;LoadId\&quot; = '&quot; +&#xA;@[User::LoadId] +&#xA;&quot;'::uuid &quot; +&#xA;&quot;ORDER BY \&quot;CrtLocId\&quot;;&quot;"
