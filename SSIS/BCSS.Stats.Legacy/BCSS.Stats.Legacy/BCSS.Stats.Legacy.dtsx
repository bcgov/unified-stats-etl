          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="[ODBC Source].[SqlCommand]">"SELECT CAST(\"LoadId\" AS varchar(36)) AS \"LoadId\", " +
"\"ReportingMonth\"::timestamp AS \"ReportingMonth\", \"CrtLocId\", " +
"CAST(CASE WHEN \"IsSupervisor\" THEN 'Y' ELSE 'N' END AS varchar(1)) AS \"SupervisorYn\", " +
"CAST(\"TargetTable\" AS varchar(30)) AS \"TargetTable\", " +
"CAST(\"TargetColumn\" AS varchar(128)) AS \"TargetColumn\", \"StatValue\" " +
"FROM etl.\"BiOracleStatStages\" " +
(LEN(@[User::LoadId]) == 0
    ? "WHERE 1 = 0;"
    : "WHERE \"LoadId\" = '" + REPLACE(@[User::LoadId], "'", "''") + "'::uuid;")</DTS:PropertyExpression>
