              SQLTask:SqlStatementSource="DECLARE&#xA;    v_table_count PLS_INTEGER;&#xA;BEGIN&#xA;    SELECT COUNT(*)&#xA;    INTO v_table_count&#xA;    FROM ALL_TABLES&#xA;    WHERE OWNER = 'COURTS'&#xA;      AND TABLE_NAME = 'BCSS_STAT_STAGE';&#xA;&#xA;    IF v_table_count = 0 THEN&#xA;        EXECUTE IMMEDIATE q'[&#xA;            CREATE TABLE COURTS.BCSS_STAT_STAGE&#xA;            (&#xA;                LOAD_ID          VARCHAR2(36 CHAR)  NOT NULL,&#xA;                REPORTING_MONTH  DATE               NOT NULL,&#xA;                CRT_LOC_ID       NUMBER             NOT NULL,&#xA;                SUPERVISOR_YN    CHAR(1 CHAR)       NOT NULL,&#xA;                TARGET_TABLE     VARCHAR2(30 CHAR)  NOT NULL,&#xA;                TARGET_COLUMN    VARCHAR2(128 CHAR) NOT NULL,&#xA;                STAT_VALUE       NUMBER,&#xA;&#xA;                CONSTRAINT BCSS_STAT_STAGE_UK&#xA;                    UNIQUE&#xA;                    (&#xA;                        LOAD_ID,&#xA;                        REPORTING_MONTH,&#xA;                        CRT_LOC_ID,&#xA;                        SUPERVISOR_YN,&#xA;                        TARGET_TABLE,&#xA;                        TARGET_COLUMN&#xA;                    ),&#xA;&#xA;                CONSTRAINT BCSS_STAT_STAGE_SUP_CK&#xA;                    CHECK (SUPERVISOR_YN IN ('Y', 'N')),&#xA;&#xA;                CONSTRAINT BCSS_STAT_STAGE_TBL_CK&#xA;                    CHECK&#xA;                    (&#xA;                        TARGET_TABLE IN&#xA;                        (&#xA;                            'SHERIFF_SRVCES',&#xA;                            'SHERIFF_SRVCES_HOURS'&#xA;                        )&#xA;                    )&#xA;            )&#xA;        ]';&#xA;    END IF;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
