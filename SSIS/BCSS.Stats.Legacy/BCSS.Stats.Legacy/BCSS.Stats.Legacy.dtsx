    <DTS:Executable
      DTS:refId="Package\Log Skipped ETL Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{c93e46b9-213f-48fe-9a52-cc3c6ccca6d7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Skipped ETL Run"
      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
          SQLTask:SqlStatementSource="UPDATE etl.&quot;BiOracleEtlRuns&quot;&#xA;SET&#xA;    &quot;Status&quot; = 'Skipped',&#xA;    &quot;CompletedAt&quot; = CURRENT_TIMESTAMP,&#xA;    &quot;StagedCellCount&quot; = 0 WHERE &quot;LoadId&quot; = ?::uuid;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="LoadId"
            SQLTask:DtsVariableName="User::LoadId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="-9"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Start Of ETL Run"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{844F5E3F-5166-4FFB-AB20-C2ABCDEFF3C4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Start Of ETL Run"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
