        <DTS:Executable
          DTS:refId="Package\Oracle Load Sequence\Reconcile Oracle Stage Count"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Fail before publication when the Oracle stage is incomplete"
          DTS:DTSID="{BA54CD55-011E-4C39-9550-49F9EF976D06}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:FailPackageOnFailure="True"
          DTS:LocaleID="-1"
          DTS:ObjectName="Reconcile Oracle Stage Count"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
              SQLTask:SqlStatementSource="WITH counts AS&#xA;(&#xA;    SELECT&#xA;        CAST(? AS integer) AS expected_count,&#xA;        CAST(? AS integer) AS actual_count,&#xA;        CAST(? AS uuid) AS load_id&#xA;)&#xA;SELECT&#xA;    CASE&#xA;        WHEN expected_count &gt; 0 AND actual_count = expected_count&#xA;        THEN actual_count&#xA;        ELSE (&#xA;            'Oracle stage reconciliation failed for LoadId '&#xA;            || load_id::text&#xA;            || ': expected '&#xA;            || expected_count::text&#xA;            || ' staged cell(s), actual '&#xA;            || actual_count::text&#xA;            || '.'&#xA;        )::integer&#xA;    END AS oracle_stage_row_count&#xA;FROM counts;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="1"
                SQLTask:DtsVariableName="User::OracleStageRowCount" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::StagedCellCount"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="4"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="User::OracleStageRowCount"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="4"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="3"
                SQLTask:DtsVariableName="User::LoadId"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="-9"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Oracle Load Sequence\Update Loaded Count"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{F9E7BE33-8EC8-4271-A2F0-9E50E9041A29}"
