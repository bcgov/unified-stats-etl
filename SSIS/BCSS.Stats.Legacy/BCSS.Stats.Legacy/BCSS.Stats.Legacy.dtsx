  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Confirm Oracle Target Safety"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{45F3A1A7-3683-44D4-B8B8-5F38392346F6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Confirm Oracle Target Safety"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
          SQLTask:SqlStatementSource="SELECT COUNT(*)::bigint AS unsafe_target_count&#xA;FROM etl.&quot;BiOracleStatStages&quot;&#xA;WHERE &quot;LoadId&quot; = ?::uuid&#xA;  AND&#xA;  (&#xA;      &quot;TargetTable&quot; NOT IN&#xA;      (&#xA;          'SHERIFF_SRVCES',&#xA;          'SHERIFF_SRVCES_HOURS'&#xA;      )&#xA;      OR &quot;TargetColumn&quot; IS NULL&#xA;      OR BTRIM(&quot;TargetColumn&quot;) = ''&#xA;      OR &quot;TargetColumn&quot; !~ '^[A-Z][A-Z0-9_]*$'&#xA;      OR &quot;TargetColumn&quot; IN&#xA;      (&#xA;          'CRT_LOC_ID',&#xA;          'MONTH',&#xA;          'SUPERVISOR_YN',&#xA;          'CREATE_DATE',&#xA;          'CREATED_BY',&#xA;          'UPDATE_DATE',&#xA;          'UPDATED_BY',&#xA;          'NIL_REPORT'&#xA;      )&#xA;  );"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::UnsafeOracleTargetCount" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="LoadId"
            SQLTask:DtsVariableName="User::LoadId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="-9"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Count Source Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{857DBEA1-6B84-4139-9DA5-67E2827D802C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Count Source Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{42C76F06-CDE1-4A8F-98EC-F69D324120CD}"
          SQLTask:SqlStatementSource="WITH params AS&#xA;(&#xA;    SELECT CAST(? AS date) AS reporting_month&#xA;)&#xA;SELECT COUNT(*) AS source_record_count&#xA;FROM &quot;StatRecords&quot; sr&#xA;CROSS JOIN params p&#xA;WHERE sr.&quot;Status&quot; IN ('SignedOff')&#xA;  AND sr.&quot;DateFrom&quot; &lt; (p.reporting_month + INTERVAL '1 month')&#xA;  AND sr.&quot;DateTo&quot; &gt;= p.reporting_month;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::SourceRecordCount" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="ReportDate"
            SQLTask:DtsVariableName="User::ReportDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="-9"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Default Month"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{73675467-B1E9-4BEC-B451-E03F23F69304}"
